from fastapi import FastAPI, Request, File, Form, UploadFile, APIRouter
from fastapi.responses import JSONResponse
from models.schemas import ChatRequest, ChatResponse
from handlers.greeting import handle_greeting
from handlers.ticket import handle_ticket_fields
from handlers.attachment_handler import handle_attachment
from utils.state import init_conversation, get_conversation_id, save_conversation_state, conversation_states,persist_conversation # persist_conversation to check data whether is saving inside mongodb 
from utils.extractor import is_issue_related, check_field_update_intent
from utils.llm import call_mistral
from typing import Optional
import re
import uuid
import httpx
import logging
from tenacity import retry, stop_after_attempt, wait_fixed
import os
from fastapi.responses import JSONResponse

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

router = APIRouter()

# Silence pymongo debug logs
logging.getLogger("pymongo").setLevel(logging.WARNING)

app = FastAPI(title="JIRA Chatbot API")

@retry(stop=stop_after_attempt(3), wait=wait_fixed(2))  # Retry 3 times with 2-second delay
async def call_knowledge_base(user_input):
    async with httpx.AsyncClient(timeout=30.0) as client:
        logger.info(f"Sending query to knowledge base: {user_input}")
        response = await client.get(
            "http://localhost:8001/chat",
            params={"user_input": user_input}
        )
        response.raise_for_status()
        logger.info(f"Received response from knowledge base: {response.json()}")
        return response.json().get("response", "No response from knowledge base")
    

@app.post("/chat", response_model=ChatResponse)
async def chat(
    request: Request,
    user_input: str = Form(...),
    #file: Optional[UploadFile] = File(None)
):
    
    user_input = user_input.strip()
    convo_id = request.cookies.get("convo_id")
    logger.info(f"📬 Request headers: {request.headers}")
    print("-------------------------------------------------------")
    logger.info(f"Received convo_id: {convo_id}") 

    if not convo_id or convo_id not in conversation_states:
        convo_id = str(uuid.uuid4())
        init_conversation(convo_id)
        state = conversation_states[convo_id]

        # Prompt user on new conversation
        response = (
            "Hi there! 👋 Would you like to proceed?<br/><br/>"
            "Please choose one:<br/><br/>"
            "b$task_management$b Create a new ticket or search in ticket<br/>"
            "b$knowledge_base$b Search the knowledge base"
        )
        state["awaiting_initial_choice"] = True
        state["conversation"].append({"role": "assistant", "content": response})
        #save_conversation_state()
        persist_conversation(convo_id, state) # to save in mongodb

        res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
        res.set_cookie("convo_id", convo_id)
        return res

    state = conversation_states[convo_id]
    conversation = state["conversation"]

    # Greet and ask user for their goal if it's a fresh conversation
    if not conversation:
        response = (
            "Hi there! 👋 Would you like to proceed?\n\n"
            "Please choose one:\n\n"
            "b$task_management$b Create a new ticket or search in ticket\n"
            "b$knowledge_base$b Search the knowledge base"
        )

        state["awaiting_initial_choice"] = True
        conversation.append({"role": "assistant", "content": response})
        #save_conversation_state()
        persist_conversation(convo_id, state) # to save the sate in mongodb
        res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
        res.set_cookie("convo_id", convo_id)
        return res

    # Handle initial choice: ticket or knowledge
    if state.get("awaiting_initial_choice"):
        cleaned_input = user_input.lower().strip()
        state["awaiting_initial_choice"] = False

        if "task_management" in cleaned_input:
            response = "Great! Let's begin creating a ticket. Please describe the issue you're facing."
            state["ticket_flow_started"] = True
        elif "knowledge_base" in cleaned_input or "search" in cleaned_input:
            response = "Sure! Please tell me what you're trying to find in the knowledge base."
            state["kb_flow_started"] = True
        else:
            response = "Please respond with either task_Management or knowledge_base to continue."
            state["awaiting_initial_choice"] = True  # Keep asking until valid
        conversation.append({"role": "assistant", "content": response})
        #save_conversation_state()
        persist_conversation(convo_id, state)# to save the state in mongodb
        res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
        res.set_cookie("convo_id", convo_id)
        return res

    # Handle greeting
    if handle_greeting(user_input, state, conversation):
        response = conversation[-1]["content"]
        #save_conversation_state()
        persist_conversation(convo_id, state) # to save the state in mongodb
        res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
        res.set_cookie("convo_id", convo_id)
        return res

    # # Add user input to conversation
    # conversation.append({"role": "user", "content": user_input})
    # #save_conversation_state()

    # Handle ticket creation confirmation
    if state.get("awaiting_ticket_confirmation"):
        cleaned_input = re.sub(r"b\$|\$b", "", user_input.lower())
        print(f"User input for ticket confirmation: {cleaned_input}")

        if cleaned_input in ["yes", "create"]:
            
            state["awaiting_ticket_confirmation"] = False
            state["awaiting_attachment_confirmation"] = True
            response = "Would you like to upload any image, PDF, video, or link with this ticket? (b$yes$b / b$no$b)"
            conversation.append({"role": "assistant", "content": response})
            logger.info(f"Starlistant: {response}")
            #save_conversation_state()
            persist_conversation(convo_id, state) # to save the state in mongodb
            res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
            res.set_cookie("convo_id", convo_id)
            return res
        elif cleaned_input in ["no"]:
            state["awaiting_ticket_confirmation"] = False
            response = (
                "Okay, I won't create a ticket.\n\n"
                "Would you like to proceed?\n\n"
                "Please choose one:\n\n"
                "b$task_management$b Create a new ticket\n"
                "b$knowledge_base$b Search the knowledge base"
            )
            logger.info(f"Starlistant: {response}")
            conversation_states.pop(convo_id, None)
            new_convo_id = str(uuid.uuid4())
            init_conversation(new_convo_id)
            state = conversation_states[new_convo_id]  # Update state to new conversation
            state["awaiting_initial_choice"] = True
            state["conversation"].append({"role": "assistant", "content": response})
            #save_conversation_state()
            persist_conversation(convo_id, state) # to save the state in mongodb
            res = JSONResponse(content=ChatResponse(convo_id=new_convo_id, response=response).dict())
            res.set_cookie("convo_id", new_convo_id)
            return res

    # Add user input to conversation
    conversation.append({"role": "user", "content": user_input})
    #save_conversation_state()
    persist_conversation(convo_id, state)  # to save the state in mongodb

    # Handle attachment confirmation or upload
    if state.get("awaiting_attachment_confirmation") or state.get("awaiting_file_upload"):
        #response = await handle_attachment(user_input, file, state, conversation, convo_id)
        response = await handle_attachment(user_input, None, state, conversation, convo_id)
        print(f"user input: {user_input}")
        if response:
            return response
        else:
            logger.warning("handle_attachment returned None but state was still awaiting attachment")

    # Ticket Flow Handling
    if state.get("ticket_flow_started"):
        response = await handle_ticket_fields(user_input, state, conversation, convo_id)
        if response:
            #save_conversation_state()
            persist_conversation(convo_id, state) # to save the state in mongodb
            res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
            res.set_cookie("convo_id", convo_id)
            return res

        field_to_update = check_field_update_intent(user_input)
        if field_to_update:
            state["awaiting_field_update"] = field_to_update
            response = f"Sure! Please tell me the new {field_to_update}."
            conversation.append({"role": "assistant", "content": response})
            logger.info(f"Starlistant: {response}")
            #save_conversation_state()
            persist_conversation(convo_id, state) # to save the state in mongodb
            res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
            res.set_cookie("convo_id", convo_id)
            return res

        if is_issue_related(user_input) and not all(state["fields"].values()):
            state["awaiting_title"] = True
            clarification_prompt = (
                f"The user said: \"{user_input.strip()}\".\n"
                "Your job is to politely ask the user to provide a short and specific title for their issue.\n"
                "Do NOT suggest or generate any title yourself.\n"
                "Only respond with one polite question asking the user to provide the title.\n"
                "Keep it short and professional.\n"
                "Example: 'Could you please provide the title of the issue you’re facing?'"
            )
            response = call_mistral(clarification_prompt)
            conversation.append({"role": "assistant", "content": response})
            logger.info(f"Starlistant: {response}")
            #save_conversation_state()
            persist_conversation(convo_id, state) # to save the state in mongodb
            res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
            res.set_cookie("convo_id", convo_id)
            return res

    # Knowledge Base Flow
    if state.get("kb_flow_started"):
        cleaned_input = user_input.strip().lower()

        # 👇 Flow reset command
        if cleaned_input in ["go back", "start over", "restart", "menu", "main menu"]:
            state.clear()
            init_conversation(convo_id)
            state = conversation_states[convo_id]
            response = (
                "Sure! You're back at the start.\n\n"
                "Please choose one:\n\n"
                "b$task_management$b Create a new ticket\n"
                "b$knowledge_base$b Search the knowledge base"
            )
            state["awaiting_initial_choice"] = True
            state["conversation"].append({"role": "assistant", "content": response})
            #save_conversation_state()
            persist_conversation(convo_id, state) # to save the state in mongodb
            return JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())

        # 👇 Switch directly to ticket flow
        if "create a ticket" in cleaned_input or "ticket" in cleaned_input:
            state["kb_flow_started"] = False
            state["ticket_flow_started"] = True
            response = "Sure, let's switch to ticket creation. Please describe the issue you're facing."
            state["conversation"].append({"role": "assistant", "content": response})
            #save_conversation_state()
            persist_conversation(convo_id, state) # to save the state in mongodb
            return JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())

        # 👇 Continue KB flow
        try:
            kb_response = await call_knowledge_base(user_input)

            # Append fallback hint to guide the user
            kb_response += (
                "\n\n_(\nYou can type 'b$go back$b' to return to menu, or 'b$create a ticket$b' to switch flows.)_"
            )

            conversation.append({"role": "assistant", "content": kb_response})
            #save_conversation_state()
            persist_conversation(convo_id, state)  # to save the state in mongodb
            res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=kb_response).dict())
            res.set_cookie("convo_id", convo_id)
            return res

        except httpx.ReadTimeout:
            error_msg = "Knowledge base API timed out after retries. Please try again later."
            logger.error(f"Knowledge base timeout: {user_input}")
            conversation.append({"role": "assistant", "content": error_msg})
            #save_conversation_state()
            persist_conversation(convo_id, state)  # to save the state in mongodb
            return JSONResponse(
                status_code=504,
                content=ChatResponse(convo_id=convo_id, response=error_msg).dict()
            )

        except httpx.HTTPError as e:
            error_msg = f"Error contacting knowledge base: {str(e)}"
            logger.error(f"Knowledge base error: {str(e)}")
            conversation.append({"role": "assistant", "content": error_msg})
            #save_conversation_state()
            persist_conversation(convo_id, state)  # to save the state in mongodb
            return JSONResponse(
                status_code=500,
                content=ChatResponse(convo_id=convo_id, response=error_msg).dict()
            )

    # Fallback: Handle unrelated input
    professional_prompt = (
        f'The user mentioned: "{user_input.strip()}".\n'
        "Respond professionally, but do not ask for title, description, or priority unless an issue is mentioned."
    )
    response = call_mistral(professional_prompt)
    conversation.append({"role": "assistant", "content": response})
    #save_conversation_state()
    persist_conversation(convo_id, state)  # to save the state in mongodb
    logger.info(f"Starlistant: {response}")
    res = JSONResponse(content=ChatResponse(convo_id=convo_id, response=response).dict())
    res.set_cookie("convo_id", convo_id)
    return res

@app.post("/upload")
async def upload_attachment(
    request: Request,
    file: Optional[UploadFile] = File(None),
):
    try:
        convo_id = request.cookies.get("convo_id") or (await request.form()).get("convo_id")
        if not convo_id:
            logger.error("No convo_id found in cookie or form data")
            return JSONResponse(status_code=400, content={"error": "Missing convo_id"})

        logger.info(f"📩 Upload triggered | convo_id: {convo_id} | file: {bool(file)}")

        state = conversation_states.get(convo_id)
        if not state:
            logger.warning("No state found for convo_id")
            return JSONResponse(status_code=400, content={"error": "No state found"})

        conversation = state.setdefault("conversation", [])

        if file:
            # Save file
            file_path = os.path.join("uploads", file.filename)
            with open(file_path, "wb") as f:
                f.write(await file.read())

            # Store metadata
            state["attachment"] = {
                "filename": file.filename,
                "path": file_path,
                "content_type": file.content_type,
            }

            state.update({
                "ready_to_submit": True,
                "awaiting_file_upload": False,
                "awaiting_attachment_confirmation": False
            })
            persist_conversation(convo_id, state)

            # ✅ Call handle_attachment to auto-create ticket
            logger.info("📬 Now calling handle_attachment to finalize ticket")
            #return await handle_attachment("", file, state, conversation, convo_id)
            # ✅ Call handle_attachment first to create the ticket
            logger.info("📬 Now calling handle_attachment to finalize ticket")
            await handle_attachment("", file, state, conversation, convo_id)

            # ✅ Get the final ticket info from state
            ticket_key = state.get("ticket_key")
            ticket_url = state.get("ticket_url")

            if ticket_key and ticket_url:
                return JSONResponse(
                    status_code=200,
                    content={
                        #"convo_id": convo_id,
                        "response": f"✅ Ticket created successfully!\n🎫 Ticket Key: {ticket_key}\n🔗 Link: {ticket_url}\n📎 Attachment uploaded: {file.filename}"
                    }
                )
            else:
                return JSONResponse(
                    status_code=500,
                    content={"error": "Ticket creation failed."}
                )

        else:
            logger.warning("No file received")
            return JSONResponse(status_code=400, content={"error": "No file provided"})

    except Exception as e:
        logger.error(f"Upload failed: {str(e)}")
        return JSONResponse(status_code=500, content={"error": "Upload failed"})




if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8008)